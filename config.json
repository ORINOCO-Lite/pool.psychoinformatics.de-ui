            "id_autogenerate_prefix": "psyinf",
            "id_autogenerate_prepend": "topic/"
        }
    },
    "id_resolves_externally": [
        "bibo",
        "doi",
        "geodata",
        "gepris",
        "IAO",
        "ISSN",
        "marcrel",
        "obo",
        "orcid",
        "ror",
        "rrid",
        "spdxlic",
        "psyinfroot"
    ],
    "show_shapes_wo_id": false,
    "show_all_fields": false,
    "show_classes": [],
    "show_classes_with_prefix": [
        "xyzra"
    ],
    "hide_classes": [],
    "hide_classes_with_prefix": [],
    "no_edit_classes": [
        "https://concepts.datalad.org/s/demo-rse-group/unreleased/XYZAgentRole",
        "https://concepts.datalad.org/s/demo-rse-group/unreleased/XYZBibliographicType"
    ],
    "allow_copy_record_urls": true,
    "allow_edit_instances": [
        "https://concepts.datalad.org/s/demo-rse-group/unreleased/XYZCommunication",
        "https://concepts.datalad.org/s/demo-rse-group/unreleased/XYZDocumentExchange",
        "https://concepts.datalad.org/s/demo-rse-group/unreleased/XYZInfluence",
        "https://concepts.datalad.org/s/demo-rse-group/unreleased/XYZPersonAttribution"
    ],
    "editor_selection": {
        "sh:datatype": {
            "xyzra:flexdate": "W3CISO8601DatePickerEditor",
            "w3ctr:NOTE-datetime": "W3CISO8601DatePickerEditor"
        },
        "shaclvue:gitAnnexUpload": {
            "true": "InstancesUploadEditor"
        }
    },
    "component_config": {
        "W3CISO8601YearMonthEditor": {
            "yearStart": 1990,
            "yearEnd": 2028
        },
        "W3CISO8601DateTimeEditor": {
            "yearStart": 1990,
            "yearEnd": 2028
        },
        "InstancesUploadEditor": {
            "xyzra:XYZDocument": {
                "pid_template": "psyinfdoc:{_randomUUID}",
                "ttl_template": "content:DocumentUploadTemplate"
            }
        },
        "InstancesSelectEditor": {
            "fetchingsRecordsText": "Fetching records...",
            "dlidentifiers:Identifier": {
                "show_classes": [],
                "show_classes_with_prefix": ["dlidentifiers"],
                "hide_classes": [],
                "hide_classes_with_prefix": []
            }
        }
    },
    "content": {
        "DocumentUploadTemplate": {
            "url": "DocumentUploadTemplate.ttl"
        }
    },
    "class_name_display": "name",
    "display_name_autogenerate": {
        "dlidentifiers:Checksum": "{dlidentifiers:creator}:{dlidentifiers:notation}",
        "dlprovmx:End": "{dltemporalmx:at_time}",
        "dlprovmx:Start": "{dltemporalmx:at_time}",
        "dlprovmx:Usage": "{rdf:object} ({dlrelationsmx:roles})",
        "dlprovmx:Association": "{rdf:object} ({dlrelationsmx:roles})",
        "xyzra:XYZAccolade": "{dlcommonmx:title}",
        "xyzra:XYZCommunication": "{rdf:object} ({dlrelationsmx:roles})",
        "xyzra:XYZConvention": "{dlcommonmx:short_name}",
        "xyzra:XYZDataset": "{dlcommonmx:title}",
        "xyzra:XYZDocument": "{dlcommonmx:title}",
        "xyzra:XYZDocumentExchange": "{rdf:object} ({dlrelationsmx:roles})",
        "xyzra:XYZGenesis": "{dlcommonmx:name}",
        "xyzra:XYZGrant": "{dlcommonmx:title}",
        "xyzra:XYZInfluence": "{rdf:object} ({dlrelationsmx:roles})",
        "xyzra:XYZInstrument": "{dlcommonmx:name}",
        "xyzra:XYZNamedDistributionPart": "{dlspatialmx:locator}",
        "xyzra:XYZObjective": "{dlcommonmx:title}",
        "xyzra:XYZPerson": "{dlsocialmx:family_name}, {dlsocialmx:given_name}",
        "xyzra:XYZPersonAttribution": "{rdf:object} ({dlrelationsmx:roles})",
        "xyzra:XYZProject": "{dlcommonmx:title}",
        "xyzra:XYZPublication": "{dlcommonmx:title}",
        "xyzra:XYZPublicationVenue": "{dlcommonmx:title}",
        "xyzra:XYZSubject": "{dlcommonmx:name}"
    },
    "display_name_autogenerate_placeholder": {
        "default": "?"
    },
    "use_service": true,
    "use_token": true,
    "token_info": "Please contact Michael Hanke at m.hanke@fz-juelich.de for credentials.",
    "token_info_url": "",
    "service_base_url": [
        {
            "url": "https://pool.psychoinformatics.de/api/protected/",
            "type": "write"
        },
        {
            "url": "https://pool.psychoinformatics.de/api/public/",
            "type": "read"
        }
    ],
    "service_constrained_search": {
        "min_characters": 3
    },
    "service_endpoints":  {
        "post-record": "record/{name}?format=ttl",
        "get-record": "record?pid={curie}&format=ttl",
        "get-records": "records/{name}?format=ttl",
        "get-paginated-records": "records/p/{name}?format=ttl&size=100&page={page_number}",
        "get-paginated-records-constrained": "records/p/{name}?format=ttl&matching=%25{match_string}%25&size=100&page={page_number}"
    },
    "service_fetch_before": {
        "get-record": [],
        "get-records": [
            "https://concepts.datalad.org/s/demo-rse-group/unreleased/XYZAgentRole",
            "https://concepts.datalad.org/s/demo-rse-group/unreleased/XYZPerson"
        ]
    },
    "use_gitannex_p2phttp": true,
    "gitannex_p2phttp_config": {
